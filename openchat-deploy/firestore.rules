rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(threadId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.members;
    }
    match /users/{uid} {
      allow get, list: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['displayName','email','photoURL','createdAt']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100;
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL']) &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100;
      allow delete: if false;
    }
    match /threads/{threadId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['members','updatedAt']) &&
        request.resource.data.members is list && request.resource.data.members.size() == 2 &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members[0] is string && request.resource.data.members[1] is string &&
        request.resource.data.members[0] < request.resource.data.members[1] &&
        threadId == request.resource.data.members[0] + '_' + request.resource.data.members[1] &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.members[0])) &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.members[1]));
      allow update: if signedIn() && request.auth.uid in resource.data.members &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
      allow delete: if false;
      match /messages/{messageId} {
        allow get, list: if member(threadId);
        allow create: if member(threadId) && request.resource.data.keys().hasOnly(['senderId','text','createdAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if member(threadId) && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
