rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function validUsername(username) {
      return username is string && username.matches('^[a-z][a-z0-9_]{2,19}$');
    }
    function validProfile(uid) {
      return signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['username', 'createdAt']) &&
        request.resource.data.keys().hasAll(['username', 'createdAt']) &&
        validUsername(request.resource.data.username) &&
        request.resource.data.createdAt is timestamp &&
        getAfter(/databases/$(database)/documents/handles/$(request.resource.data.username)).data.uid == uid;
    }
    function member(threadId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.members;
    }

    // Presence is a heartbeat, not a permanent "online" flag. A friend
    // checks its server timestamp and considers it stale after 105 seconds.
    // Presence is visible only to participants in an EXISTING private thread.
    function privateThreadId(uid) {
      return request.auth.uid < uid
        ? request.auth.uid + '_' + uid
        : uid + '_' + request.auth.uid;
    }
    function canSeePresence(uid) {
      let id = privateThreadId(uid);
      return request.auth.uid == uid ||
        (
          exists(/databases/$(database)/documents/threads/$(id)) &&
          get(/databases/$(database)/documents/threads/$(id)).data.members is list &&
          get(/databases/$(database)/documents/threads/$(id)).data.members.hasAll([request.auth.uid, uid])
        );
    }
    match /presence/{uid} {
      allow get: if signedIn() && canSeePresence(uid);
      allow list: if false;
      // A member controls only their own timestamp, issued by Firestore.
      // Nothing here authorizes reads of a user's profile or chat messages.
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['lastActiveAt']) &&
        request.resource.data.keys().hasAll(['lastActiveAt']) &&
        request.resource.data.lastActiveAt == request.time;
      allow delete: if false;
    }

    // Public directory contains only the handle and its user's UID, not email.
    match /handles/{username} {
      allow get, list: if signedIn();
      allow create: if signedIn() && validUsername(username) &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.keys().hasAll(['uid']) &&
        request.resource.data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }

    match /users/{uid} {
      // Migrated legacy profiles are readable by their owner only until they set a handle.
      allow get: if signedIn() &&
        (request.auth.uid == uid || 'username' in resource.data);
      allow list: if false;
      allow create: if validProfile(uid);
      // Existing Google-only profile (without a username) may be upgraded once.
      // Usernames cannot be changed after claiming them.
      allow update: if validProfile(uid) &&
        !('username' in resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Replies quote only an actual message from the SAME private chat.
    function validReply(threadId) {
      return !('replyTo' in request.resource.data) || (
        request.resource.data.replyTo is map &&
        request.resource.data.replyTo.keys().hasOnly(['id', 'senderId', 'text']) &&
        request.resource.data.replyTo.keys().hasAll(['id', 'senderId', 'text']) &&
        request.resource.data.replyTo.id is string &&
        request.resource.data.replyTo.id.size() == 20 &&
        request.resource.data.replyTo.id.matches('^[A-Za-z0-9]+$') &&
        request.resource.data.replyTo.senderId is string &&
        request.resource.data.replyTo.text is string &&
        request.resource.data.replyTo.text.size() <= 1000 &&
        exists(/databases/$(database)/documents/threads/$(threadId)/messages/$(request.resource.data.replyTo.id)) &&
        get(/databases/$(database)/documents/threads/$(threadId)/messages/$(request.resource.data.replyTo.id)).data.senderId == request.resource.data.replyTo.senderId &&
        get(/databases/$(database)/documents/threads/$(threadId)/messages/$(request.resource.data.replyTo.id)).data.text == request.resource.data.replyTo.text
      );
    }

    match /threads/{threadId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['members', 'updatedAt']) &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2 &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members[0] is string &&
        request.resource.data.members[1] is string &&
        request.resource.data.members[0] < request.resource.data.members[1] &&
        threadId == request.resource.data.members[0] + '_' + request.resource.data.members[1] &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.members[0])) &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.members[1]));
      allow update: if signedIn() && request.auth.uid in resource.data.members &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
      allow delete: if false;

      // Ephemeral activity status: only chat members can read the other person's
      // status, and only the signed-in user may update their OWN document.
      match /typing/{uid} {
        allow get: if member(threadId);
        allow list: if false;
        allow create, update: if member(threadId) &&
          request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['active', 'updatedAt']) &&
          request.resource.data.keys().hasAll(['active', 'updatedAt']) &&
          request.resource.data.active is bool &&
          request.resource.data.updatedAt == request.time;
        allow delete: if member(threadId) && request.auth.uid == uid;
      }

      // Two tiny private games, stored separately from message documents.
      // Games cannot send messages or change reactions/typing/receipts.
      function gameMembers() {
        return get(/databases/$(database)/documents/threads/$(threadId)).data.members;
      }
      function gameOtherUid() {
        return gameMembers()[0] == request.auth.uid
          ? gameMembers()[1] : gameMembers()[0];
      }
      function gameStartingUid(round) {
        return round % 2 == 0 ? gameMembers()[0] : gameMembers()[1];
      }
      function gameFreshEnough() {
        return request.time >= resource.data.updatedAt &&
          request.time - resource.data.updatedAt < duration.value(1, 'h');
      }
      function blankTttCells() {
        return {'0':'','1':'','2':'','3':'','4':'',
                '5':'','6':'','7':'','8':''};
      }
      function tttLine(c,mark,a,b,d) {
        return c.get(a, '') == mark &&
          c.get(b, '') == mark && c.get(d, '') == mark;
      }
      function tttHasWon(c,mark) {
        return tttLine(c,mark,'0','1','2') ||
          tttLine(c,mark,'3','4','5') ||
          tttLine(c,mark,'6','7','8') ||
          tttLine(c,mark,'0','3','6') ||
          tttLine(c,mark,'1','4','7') ||
          tttLine(c,mark,'2','5','8') ||
          tttLine(c,mark,'0','4','8') ||
          tttLine(c,mark,'2','4','6');
      }
      function validTttCell(before,after,mark,i) {
        return before.get(i,'') == '' &&
          after.get(i,'') == mark &&
          after.diff(before).affectedKeys().hasOnly([i]) &&
          after.diff(before).affectedKeys().size() == 1;
      }
      function validTttStep(before,after,mark) {
        return before is map && after is map &&
          after.keys().hasOnly(['0','1','2','3','4','5','6','7','8']) &&
          after.size() == 9 &&
          (
            validTttCell(before,after,mark,'0') ||
            validTttCell(before,after,mark,'1') ||
            validTttCell(before,after,mark,'2') ||
            validTttCell(before,after,mark,'3') ||
            validTttCell(before,after,mark,'4') ||
            validTttCell(before,after,mark,'5') ||
            validTttCell(before,after,mark,'6') ||
            validTttCell(before,after,mark,'7') ||
            validTttCell(before,after,mark,'8')
          );
      }
      function tttExpectedResult(c,mark,moves) {
        return tttHasWon(c,mark) ? mark : (moves == 9 ? 'draw' : '');
      }
      function tttCreateValid() {
        return request.resource.data.keys().hasOnly([
            'cells','moves','turn','winner','round','createdAt','updatedAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'cells','moves','turn','winner','round','createdAt','updatedAt'
          ]) &&
          request.resource.data.cells == blankTttCells() &&
          request.resource.data.moves == 0 &&
          request.resource.data.round == 0 &&
          request.resource.data.winner == '' &&
          request.resource.data.turn == gameMembers()[0] &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
      }
      function tttMoveValid() {
        let mark = request.auth.uid == gameMembers()[0] ? 'X' : 'O';
        let outcome = tttExpectedResult(
          request.resource.data.cells,mark,request.resource.data.moves
        );
        return resource.data.winner == '' &&
          resource.data.turn == request.auth.uid &&
          resource.data.moves is int &&
          request.resource.data.moves == resource.data.moves + 1 &&
          request.resource.data.moves <= 9 &&
          request.resource.data.round == resource.data.round &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['cells','moves','turn','winner','updatedAt']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAll(['cells','moves','turn','updatedAt']) &&
          validTttStep(resource.data.cells,request.resource.data.cells,mark) &&
          request.resource.data.winner == outcome &&
          request.resource.data.turn == (outcome != '' ? '' : gameOtherUid());
      }
      function tttRestartValid() {
        return (resource.data.winner != '' || !gameFreshEnough()) &&
          request.resource.data.round == resource.data.round + 1 &&
          request.resource.data.cells == blankTttCells() &&
          request.resource.data.moves == 0 &&
          request.resource.data.winner == '' &&
          request.resource.data.turn == gameStartingUid(request.resource.data.round) &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['cells','moves','turn','winner','round','updatedAt']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAll(['round','updatedAt']);
      }
      function quizCreateValid() {
        return request.resource.data.keys().hasOnly([
            'answers','round','createdAt','updatedAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'answers','round','createdAt','updatedAt'
          ]) &&
          request.resource.data.answers == {} &&
          request.resource.data.round == 0 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
      }
      function quizNextAnswer(before,after,index,n) {
        return before.size() == n &&
          after.size() == n + 1 &&
          !(index in before) &&
          after.get(index,-1) is int &&
          after.get(index,-1) >= 0 &&
          after.get(index,-1) <= 3 &&
          after.diff(before).affectedKeys().hasOnly([index]) &&
          after.diff(before).addedKeys().hasAll([index]);
      }
      function quizOwnAnswerChanged() {
        let old = resource.data.answers;
        let next = request.resource.data.answers;
        let before = old.get(request.auth.uid,{});
        let after = next.get(request.auth.uid,{});
        return old is map && next is map &&
          before is map && after is map &&
          next.size() <= 2 &&
          next.keys().hasOnly(gameMembers()) &&
          next.diff(old).affectedKeys().hasOnly([request.auth.uid]) &&
          next.diff(old).affectedKeys().hasAll([request.auth.uid]) &&
          after.keys().hasOnly(['0','1','2','3','4']) &&
          (
            quizNextAnswer(before,after,'0',0) ||
            quizNextAnswer(before,after,'1',1) ||
            quizNextAnswer(before,after,'2',2) ||
            quizNextAnswer(before,after,'3',3) ||
            quizNextAnswer(before,after,'4',4)
          );
      }
      function quizAnswerValid() {
        return request.resource.data.round == resource.data.round &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answers','updatedAt']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAll(['answers','updatedAt']) &&
          quizOwnAnswerChanged();
      }
      function quizFinished() {
        return resource.data.answers.get(gameMembers()[0],{}).size() == 5 &&
          resource.data.answers.get(gameMembers()[1],{}).size() == 5;
      }
      function quizRestartValid() {
        return (quizFinished() || !gameFreshEnough()) &&
          request.resource.data.answers == {} &&
          request.resource.data.round == resource.data.round + 1 &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answers','round','updatedAt']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAll(['round','updatedAt']);
      }
      match /games/{gameId} {
        allow get: if member(threadId) && gameId in ['ttt','quiz'];
        allow list: if false;
        allow create: if member(threadId) &&
          (
            (gameId == 'ttt' && tttCreateValid()) ||
            (gameId == 'quiz' && quizCreateValid())
          );
        allow update: if member(threadId) &&
          (
            (gameId == 'ttt' && (tttMoveValid() || tttRestartValid())) ||
            (gameId == 'quiz' && (quizAnswerValid() || quizRestartValid()))
          );
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow get, list: if member(threadId);
        allow create: if member(threadId) &&
          request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt', 'replyTo']) &&
          validReply(threadId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000 &&
          // Use a server-issued send time, not a user-controlled timestamp.
          request.resource.data.createdAt == request.time;
        // Only the receiving participant may acknowledge delivery/read.
        // Never permit changing sender, text or creation time.
        allow update: if member(threadId) &&
          request.auth.uid != resource.data.senderId &&
          request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt', 'replyTo', 'editedAt', 'deliveredAt', 'seenAt', 'reactions']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt', 'seenAt']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveredAt', 'seenAt']) &&
          ('deliveredAt' in request.resource.data) &&
          request.resource.data.deliveredAt is timestamp &&
          (
            (!('deliveredAt' in resource.data) && request.resource.data.deliveredAt == request.time) ||
            ('deliveredAt' in resource.data && request.resource.data.deliveredAt == resource.data.deliveredAt)
          ) &&
          (
            !('seenAt' in request.resource.data) ||
            (
              request.resource.data.seenAt is timestamp &&
              request.resource.data.seenAt >= request.resource.data.deliveredAt &&
              (
                (!('seenAt' in resource.data) && request.resource.data.seenAt == request.time) ||
                ('seenAt' in resource.data && request.resource.data.seenAt == resource.data.seenAt)
              )
            )
          );
        // Only the author can edit the message text during the first 15 minutes.
        // The server controls editedAt, and all other fields stay unchanged,
        // including author, original timestamp, reply, and delivery/read ticks.
        allow update: if member(threadId) &&
          request.auth.uid == resource.data.senderId &&
          resource.data.createdAt is timestamp &&
          request.time >= resource.data.createdAt &&
          request.time - resource.data.createdAt < duration.value(15, 'm') &&
          request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt', 'replyTo', 'editedAt', 'deliveredAt', 'seenAt', 'reactions']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasAll(['text', 'editedAt']) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000 &&
          request.resource.data.text != resource.data.text &&
          request.resource.data.editedAt == request.time;
        // One emoji reaction per participant, including on messages they received.
        // The caller may change ONLY their own entry of the reactions map.
        // A nested FieldPath write preserves simultaneous reactions, message edits,
        // sender/original timestamp, replies, and the delivery/read receipts.
        allow update: if member(threadId) &&
          request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt', 'replyTo', 'editedAt', 'deliveredAt', 'seenAt', 'reactions']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactions']) &&
          request.resource.data.get('reactions', {}) is map &&
          request.resource.data.get('reactions', {}).size() <= 2 &&
          request.resource.data.get('reactions', {}).keys().hasOnly(
            get(/databases/$(database)/documents/threads/$(threadId)).data.members
          ) &&
          request.resource.data.get('reactions', {}).diff(
            resource.data.get('reactions', {})
          ).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.get('reactions', {}).diff(
            resource.data.get('reactions', {})
          ).affectedKeys().hasAny([request.auth.uid]) &&
          (
            !(request.auth.uid in request.resource.data.get('reactions', {})) ||
            (
              request.resource.data.get('reactions', {})[request.auth.uid] is string &&
              request.resource.data.get('reactions', {})[request.auth.uid].size() > 0 &&
              request.resource.data.get('reactions', {})[request.auth.uid].size() <= 32
            )
          );
        allow delete: if member(threadId) &&
          resource.data.senderId == request.auth.uid;
      }
    }
  }
}
